# 雾影猎人交易站 环境变量配置
# 复制本文件为 .env 并填入真实密钥（不配置密钥时支付走"演示模式"，其余功能正常）

PORT=3000

# ---------------- 贝宝 (PayPal) ----------------
# 模式：sandbox（测试）或 live（正式）
PAYPAL_MODE=sandbox
# 在 https://developer.paypal.com 创建应用后获取
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ---------------- 国际支付宝 (Alipay Global) ----------------
# 在支付宝开放平台(open.alipay.com) 创建应用后获取
ALIPAY_APP_ID=
# 应用私钥（RSA2，PEM 格式；多行内容在 .env 中用 \n 转义）
ALIPAY_APP_PRIVATE_KEY=
# 支付宝公钥（用于异步通知验签）
ALIPAY_PUBLIC_KEY=
# 支付成功后的异步通知与跳转地址（需公网可访问，如 https://your-domain.com/api/alipay/notify）
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
